@startuml
title <size:24>Deployment View: VotoEPIS - Producción</size>\n<size:24>Vista de despliegue en entorno de Producción (MVP).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Producción.Dispositivodelusuario, "Dispositivo del usuario", $type="PC o Móvil (Navegador Web)", $descr="Cliente de votación y consulta", $tags="", $link="") {
  Container(Producción.Dispositivodelusuario.Aplicaciónweb_1, "Aplicación web", $techn="Web", $descr="Presenta la interfaz de votación, el panel electoral y la consulta pública de resultados.", $tags="", $link="")
}

Deployment_Node(Producción.VPSEconómicoR04, "VPS Económico (R-04)", $type="Ubuntu 24.04 LTS (2 vCPU, 4 GB RAM)", $descr="Servidor único de bajo presupuesto para el MVP", $tags="", $link="") {
  Deployment_Node(Producción.VPSEconómicoR04.DockerCompose, "Docker Compose", $type="Docker Engine 27 + Nginx", $descr="Orquestación local de contenedores", $tags="", $link="") {
    Container(Producción.VPSEconómicoR04.DockerCompose.AplicaciónVotoEPIS_1, "Aplicación VotoEPIS", $techn="Monolito en capas", $descr="Implementa las reglas de acceso, padrón, votación, conteo, resultados y actas.", $tags="", $link="")
    ContainerDb(Producción.VPSEconómicoR04.DockerCompose.Basededatos_1, "Base de datos", $techn="PostgreSQL 16", $descr="Almacena padrón, participaciones, votos, resultados, actas y registros de auditoría.", $tags="", $link="")
  }

}

Rel(Producción.Dispositivodelusuario.Aplicaciónweb_1, Producción.VPSEconómicoR04.DockerCompose.AplicaciónVotoEPIS_1, "Solicita operaciones electorales", $techn="HTTPS", $tags="", $link="")
Rel(Producción.VPSEconómicoR04.DockerCompose.AplicaciónVotoEPIS_1, Producción.VPSEconómicoR04.DockerCompose.Basededatos_1, "Consulta y registra información electoral", $techn="SQL", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml