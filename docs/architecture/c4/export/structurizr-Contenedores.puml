@startuml
title <size:24>Container View: VotoEPIS</size>\n<size:24>Nivel 2: contenedores lógicos de VotoEPIS y sus relaciones.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Estudiantevotante, "Estudiante votante", $descr="Consulta su habilitación, emite su voto y revisa los resultados.", $tags="", $link="")
Person(Comitéelectoral, "Comité electoral", $descr="Gestiona el padrón, administra las elecciones y publica resultados y actas.", $tags="", $link="")
Person(Auditor, "Auditor", $descr="Revisa los resultados y verifica el acta electoral.", $tags="", $link="")
System(Serviciodecorreoinstitucional, "Servicio de correo institucional", $descr="Servicio externo de envío de correos y confirmaciones.", $tags="", $link="")
System(SistemaacadémicoUNSA, "Sistema académico UNSA", $descr="Posible fuente de información para verificar la habilitación de estudiantes; integración pendiente de confirmar.", $tags="", $link="")

System_Boundary("VotoEPIS_boundary", "VotoEPIS", $tags="") {
  ContainerDb(VotoEPIS.Basededatos, "Base de datos", $techn="PostgreSQL 16", $descr="Almacena padrón, participaciones, votos, resultados, actas y registros de auditoría.", $tags="", $link="")
  Container(VotoEPIS.Aplicaciónweb, "Aplicación web", $techn="Web", $descr="Presenta la interfaz de votación, el panel electoral y la consulta pública de resultados.", $tags="", $link="")
  Container(VotoEPIS.AplicaciónVotoEPIS, "Aplicación VotoEPIS", $techn="Monolito en capas", $descr="Implementa las reglas de acceso, padrón, votación, conteo, resultados y actas.", $tags="", $link="")
}

Rel(Estudiantevotante, VotoEPIS.Aplicaciónweb, "Emite votos y consulta resultados", $techn="HTTPS", $tags="", $link="")
Rel(Comitéelectoral, VotoEPIS.Aplicaciónweb, "Administra elecciones y publica actas", $techn="HTTPS", $tags="", $link="")
Rel(Auditor, VotoEPIS.Aplicaciónweb, "Consulta resultados y actas", $techn="HTTPS", $tags="", $link="")
Rel(VotoEPIS.Aplicaciónweb, VotoEPIS.AplicaciónVotoEPIS, "Solicita operaciones electorales", $techn="HTTPS", $tags="", $link="")
Rel(VotoEPIS.AplicaciónVotoEPIS, VotoEPIS.Basededatos, "Consulta y registra información electoral", $techn="SQL", $tags="", $link="")
Rel(VotoEPIS.AplicaciónVotoEPIS, Serviciodecorreoinstitucional, "Solicita el envío de correos institucionales", $techn="SMTP", $tags="", $link="")
Rel(VotoEPIS.AplicaciónVotoEPIS, SistemaacadémicoUNSA, "Consulta información de habilitación (propuesta)", $techn="Integración por definir", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml