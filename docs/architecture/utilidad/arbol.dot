  s1 [label="S1 · Integridad (H,H) · ADD 1\n100 % de duplicados rechazados", fillcolor="#ffe4bb", penwidth=2];
  s4 [label="S4 · Auditabilidad (H,M)\n100 % resultados con acta/listado/huella\n0 diferencias de conteo"];
