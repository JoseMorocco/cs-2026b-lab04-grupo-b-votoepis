  s3 [label="S3 · Continuidad (H,H)\n≥99,5 % de sondeos en ≤2 s\n≤144 fallos / 28 800 sondeos"];
  s6 [label="S6 · Tiempo de respuesta (M,H)\np95 ≤2 s; errores técnicos ≤1 %\nMedia y concentración supuesta"];
  s7 [label="S7 · Extensión del padrón (M,L)\n0 líneas cambiadas en el servicio\n100 % suite previa; 1 prueba nueva"];
