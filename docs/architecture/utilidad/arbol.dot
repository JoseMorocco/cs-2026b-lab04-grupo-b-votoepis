  edge [color="#7990a5"];
  utilidad [label="Utilidad\nVotoEPIS", fillcolor="#173b60", fontcolor=white];
  seguridad [label="Seguridad\nQA-01 / QA-03", fillcolor="#d6e8fc"];
  disponibilidad [label="Disponibilidad\nQA-02", fillcolor="#d6e8fc"];
