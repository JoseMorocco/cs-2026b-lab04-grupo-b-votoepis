@startuml clases

top to bottom direction

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45

title Diagrama de Clases Actualizado — VotoEPIS (Lab 07)

package "dominio" {
    enum EstadoEleccion {
        CONFIGURADA
        ABIERTA
        CERRADA
        ESCRUTADA
        PUBLICADA
    }

    class Estudiante {
        +id: UUID
        +codigo: str
        +correo_institucional: str
    }

    class Candidato {
        +id: UUID
        +nombre: str
        +agrupacion: str
    }

    class Eleccion <<Context>> {
        +id: UUID
        +titulo: str
        +estado: EstadoEleccion
        +candidatos: list[Candidato]
        +abrir(padron_cargado: bool): void
        +cerrar(): void
        +iniciar_escrutinio(autorizado: bool): void
        +publicar_resultados(acta_firmada: bool, totales_verificados: bool): void
    }

    interface PadronPort <<Strategy>> {
        +{abstract} esta_habilitado(estudiante_id: UUID, eleccion_id: UUID): bool
    }
}

package "estados (State)" {
    abstract class EstadoBase <<State>> {
        +abrir(eleccion, padron_cargado): void
        +cerrar(eleccion): void
        +iniciar_escrutinio(eleccion, autorizado): void
        +publicar_resultados(eleccion, acta_firmada, totales_verificados): void
    }

    class Configurada
    class Abierta
    class Cerrada
    class Escrutada
    class Publicada
}

package "elegibilidad y decoradores" {
    class FabricaFuentes <<Factory>> {
        +registrar(nombre: str, creador: Callable): void
        +crear(nombre: str): PadronPort
    }

    class PadronLocalAdapter <<Adapter>>
    class SistemaAcademicoAdapter <<Adapter>>

    class ConReintentos <<Decorator>> {
        +intentos: int
        +esta_habilitado(estudiante_id: UUID, eleccion_id: UUID): bool
    }
}

package "eventos (Observer)" {
    class PublicadorEventos <<Subject>> {
        +suscribir(nombre_evento: str, suscriptor): void
        +publicar(nombre_evento: str, datos: dict): void
    }

    class ConfirmacionCorreo <<Observer>>
    class AuditoriaSeguridad <<Observer>>
}

package "servicio" {
    class ServicioVotacion <<Client>> {
        +emitir_voto(estudiante_id, eleccion_id, candidato_id, fuente): bool
    }
}

package "IA (Strategy + Adapter + Decorator + Chain)" {
    class AsistenteReglamento

    interface ProveedorLLM <<Strategy>>

    class AdaptadorLLMSimulado <<Adapter>>

    class ConCache <<Decorator>>

    abstract class Guardrail <<Handler>>

    class SinIndicacionesDeVoto <<Handler>>

    class SinResultadosInventados <<Handler>>
}

Eleccion "1" *-- "1..*" Candidato
Eleccion --> EstadoBase

EstadoBase <|-- Configurada
EstadoBase <|-- Abierta
EstadoBase <|-- Cerrada
EstadoBase <|-- Escrutada
EstadoBase <|-- Publicada

ServicioVotacion --> FabricaFuentes
ServicioVotacion --> PublicadorEventos

FabricaFuentes ..> PadronPort
PadronPort <|.. PadronLocalAdapter
PadronPort <|.. SistemaAcademicoAdapter
PadronPort <|.. ConReintentos

ConReintentos o--> PadronPort

PublicadorEventos --> ConfirmacionCorreo
PublicadorEventos --> AuditoriaSeguridad

AsistenteReglamento --> ProveedorLLM
AsistenteReglamento --> Guardrail

ProveedorLLM <|.. AdaptadorLLMSimulado
ProveedorLLM <|.. ConCache

Guardrail <|-- SinIndicacionesDeVoto
Guardrail <|-- SinResultadosInventados

ConReintentos -[hidden]down-> AsistenteReglamento
PublicadorEventos -[hidden]down-> AsistenteReglamento
FabricaFuentes -[hidden]down-> AsistenteReglamento

@enduml