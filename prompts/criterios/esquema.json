{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Criterios de aceptación de una historia",
  "type": "object",
  "additionalProperties": false,
  "required": ["historia_id", "invest_ok", "preguntas", "escenarios"],
  "properties": {
    "historia_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "invest_ok": {"type": "boolean"},
    "preguntas": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/texto"}
    },
    "escenarios": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/definitions/escenario"}
    }
  },
  "if": {"properties": {"invest_ok": {"const": false}}},
  "then": {
    "properties": {
      "preguntas": {"minItems": 1},
      "escenarios": {"maxItems": 0}
    }
  },
  "else": {"properties": {"escenarios": {"minItems": 1}}},
  "definitions": {
    "texto": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
    "pasos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"$ref": "#/definitions/texto"}
    },
    "escenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "tipo", "dado", "cuando", "entonces"],
      "properties": {
        "titulo": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
        "tipo": {"enum": ["exito", "error", "borde"]},
        "dado": {"$ref": "#/definitions/pasos"},
        "cuando": {"$ref": "#/definitions/texto"},
        "entonces": {"$ref": "#/definitions/pasos"}
      }
    }
  }
}
