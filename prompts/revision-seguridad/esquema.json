{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["historia_id", "hallazgos", "revision_completa"],
  "properties": {
    "historia_id": {"type": "string", "pattern": "^SEC-[0-9]{2}$"},
    "revision_completa": {"type": "boolean"},
    "hallazgos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["linea", "regla", "severidad", "descripcion", "recomendacion"],
        "properties": {
          "linea": {"type": "integer", "minimum": 1},
          "regla": {"enum": ["AUTH", "PRIV", "INTEG", "VALID", "AUDIT"]},
          "severidad": {"enum": ["alta", "media", "baja"]},
          "descripcion": {"type": "string", "minLength": 12},
          "recomendacion": {"type": "string", "minLength": 12}
        }
      }
    }
  }
}
